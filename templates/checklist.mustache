{{!
    @template assignsubmission_vrtour/checklist

    What a tour needs before it can be handed in, ticked off as the student goes.

    Context variables required for this template:
    * items - list of {done, label, count}

    Example context (json):
    {"items": [{"done": true, "label": "At least one 360° photo", "count": "1 so far"},
               {"done": false, "label": "At least 3 points of interest", "count": "2 so far"}]}
}}
<ul class="list-unstyled mb-0 assignsubmission_vrtour-checklist" data-region="assignsubmission_vrtour-checklist">
    {{#items}}
    <li class="d-flex align-items-center gap-2 mb-1" data-done="{{#done}}1{{/done}}{{^done}}0{{/done}}">
        {{#done}}{{#pix}}i/checkedcircle, core, {{#str}}checkdone, assignsubmission_vrtour{{/str}}{{/pix}}{{/done}}
        {{^done}}<span class="assignsubmission_vrtour-todo" role="img" aria-label="{{#str}}checktodo, assignsubmission_vrtour{{/str}}"></span>{{/done}}
        <span>{{label}}</span> <span class="text-body-secondary small">({{count}})</span>
    </li>
    {{/items}}
</ul>
